<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/feedFragment">

    <fragment
        android:id="@+id/feedFragment"
        android:name="applicationId.ru.netology.nmedia.fragment.FeedFragment"
        android:label="FeedFragment"
        tools:layout="@layout/fragment_feed">

        <action
            android:id="@+id/action_feedFragment_to_newPostFragment"
            app:destination="@id/newPostFragment" />

        <action
            android:id="@+id/action_feedFragment_to_postFragment"
            app:destination="@id/postFragment" />

        <action
            android:id="@+id/action_feedFragment_to_mapFragment"
            app:destination="@id/mapFragment" />
    </fragment>

    <fragment
        android:id="@+id/newPostFragment"
        android:name="applicationId.ru.netology.nmedia.fragment.NewPostFragment"
        android:label="NewPostFragment"
        tools:layout="@layout/fragment_new_post">

        <argument
            android:name="post"
            android:defaultValue="@null"
            app:argType="applicationId.ru.netology.nmedia.dto.Post"
            app:nullable="true" />
    </fragment>

    <fragment
        android:id="@+id/postFragment"
        android:name="applicationId.ru.netology.nmedia.fragment.PostFragment"
        android:label="PostFragment"
        tools:layout="@layout/fragment_post">

        <argument
            android:name="postId"
            app:argType="long" />

        <action
            android:id="@+id/action_postFragment_to_newPostFragment"
            app:destination="@id/newPostFragment">

            <argument
                android:name="post"
                android:defaultValue="@null"
                app:argType="applicationId.ru.netology.nmedia.dto.Post"
                app:nullable="true" />
        </action>
    </fragment>

    <fragment
        android:id="@+id/mapFragment"
        android:name="applicationId.ru.netology.nmedia.fragment.MapFragment"
        android:label="@string/open_map"
        tools:layout="@layout/fragment_map" />

    <fragment
        android:id="@+id/pointsListFragment"
        android:name="applicationId.ru.netology.nmedia.fragment.PointsListFragment"
        android:label="@string/all_points"
        tools:layout="@layout/fragment_points_list" />
</navigation>