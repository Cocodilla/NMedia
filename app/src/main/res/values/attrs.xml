<resources>

    <declare-styleable name="StatsView">

        <attr name="lineWidth" format="dimension"/>
        <attr name="fontSize" format="dimension"/>
        <attr name="animationDuration" format="integer"/>
        <attr name="emptyColor" format="color"/>

        <attr name="fillMode" format="enum">
            <enum name="parallel" value="0"/>
            <enum name="sequential" value="1"/>
            <enum name="bidirectional" value="2"/>
        </attr>

    </declare-styleable>

</resources>